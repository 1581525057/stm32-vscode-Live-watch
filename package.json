{
  "name": "stm32-vscode-Live-watch",
  "displayName": "STM32 Live Watch",
  "description": "STM32 实时变量监视与图表可视化 VS Code 插件，支持 EIDE AXF 自动转换 ELF 后读取、修改和绘制全局变量。",
  "version": "3.7.0",
  "publisher": "yezi",
  "author": "ciyueYe",
  "icon": "resources/icon.jpg",
  "keywords": [
    "STM32",
    "CMake",
    "Embedded",
    "Debug",
    "OpenOCD"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/1581525057/stm32-vscode-Live-watch.git"
  },
  "bugs": {
    "url": "https://github.com/1581525057/stm32-vscode-Live-watch/issues"
  },
  "homepage": "https://github.com/1581525057/stm32-vscode-Live-watch#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onDebug"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "stm32-live-watch.startServer",
        "title": "STM32 Live Watch: Start Server",
        "icon": "$(debug-start)"
      },
      {
        "command": "stm32-live-watch.stopServer",
        "title": "STM32 Live Watch: Stop Server",
        "icon": "$(debug-stop)"
      },
      {
        "command": "stm32-live-watch.generateElf",
        "title": "STM32 Live Watch: Generate ELF from AXF",
        "icon": "$(tools)"
      },
      {
        "command": "stm32-live-watch.configureElfPath",
        "title": "STM32 Live Watch: Configure ELF Path",
        "icon": "$(file-code)"
      },
      {
        "command": "stm32-live-watch.refreshVariables",
        "title": "STM32 Live Watch: Refresh Variables",
        "icon": "$(refresh)"
      },
      {
        "command": "stm32-live-watch.dumpDwarfVars",
        "title": "STM32 Live Watch: Dump DWARF Variables (Debug)",
        "icon": "$(bug)"
      },
      {
        "command": "stm32-live-watch.addVariable",
        "title": "STM32 Live Watch: Add Variable",
        "icon": "$(add)"
      },
      {
        "command": "stm32-live-watch.addSelectedVariable",
        "title": "STM32 Live Watch: Add Selected Variable",
        "icon": "$(add)"
      },
      {
        "command": "stm32-live-watch.editVariable",
        "title": "STM32 Live Watch: Edit Variable Value",
        "icon": "$(edit)"
      },
      {
        "command": "stm32-live-watch.renameVariable",
        "title": "STM32 Live Watch: Rename Variable Expression",
        "icon": "$(symbol-key)"
      },
      {
        "command": "stm32-live-watch.deleteVariable",
        "title": "STM32 Live Watch: Delete Variable",
        "icon": "$(trash)"
      },
      {
        "command": "stm32-live-watch.showBottomPanel",
        "title": "STM32 Live Watch: Show Variables",
        "icon": "$(eye)"
      },
      {
        "command": "stm32-live-watch.addToChart",
        "title": "STM32 Live Watch: Add to Chart",
        "icon": "$(graph)"
      },
      {
        "command": "stm32-live-watch.showChartPanel",
        "title": "STM32 Live Watch: Show Chart Panel",
        "icon": "$(graph)"
      },
      {
        "command": "stm32-live-watch.addWatchPage",
        "title": "STM32 Live Watch: Add Watch Page",
        "icon": "$(add)"
      },
      {
        "command": "stm32-live-watch.renameWatchPage",
        "title": "STM32 Live Watch: Rename Watch Page",
        "icon": "$(edit)"
      },
      {
        "command": "stm32-live-watch.deleteWatchPage",
        "title": "STM32 Live Watch: Delete Watch Page",
        "icon": "$(trash)"
      },
      {
        "command": "stm32-live-watch.prevWatchPage",
        "title": "STM32 Live Watch: Previous Watch Page",
        "icon": "$(chevron-left)"
      },
      {
        "command": "stm32-live-watch.nextWatchPage",
        "title": "STM32 Live Watch: Next Watch Page",
        "icon": "$(chevron-right)"
      },
      {
        "command": "stm32-live-watch.addChartPage",
        "title": "STM32 Live Watch: Add Chart Page",
        "icon": "$(add)"
      },
      {
        "command": "stm32-live-watch.renameChartPage",
        "title": "STM32 Live Watch: Rename Chart Page",
        "icon": "$(edit)"
      },
      {
        "command": "stm32-live-watch.deleteChartPage",
        "title": "STM32 Live Watch: Delete Chart Page",
        "icon": "$(trash)"
      },
      {
        "command": "stm32-live-watch.watchPageIndicator",
        "title": "Watch Page",
        "icon": "$(list-flat)",
        "enablement": "false"
      },
      {
        "command": "stm32-live-watch.moreActions",
        "title": "More Actions...",
        "icon": "$(ellipsis)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stm32-debug-panel",
          "title": "STM32 Live Watch",
          "icon": "resources/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "stm32-chart-container",
          "title": "STM32 Variable Chart",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "stm32-debug-panel": [
        {
          "id": "stm32-debug-variables-panel",
          "name": "Live Watch 实时变量",
          "icon": "resources/icon.svg"
        },
        {
          "id": "stm32-debug-operations-panel",
          "name": "操作",
          "icon": "resources/icon.svg"
        }
      ],
      "stm32-chart-container": [
        {
          "type": "webview",
          "id": "stm32-debug-chart-panel",
          "name": "Variable Chart"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "stm32-live-watch.startServer",
          "when": "view == stm32-debug-variables-panel && !stm32LiveWatch.serverRunning",
          "group": "navigation@1"
        },
        {
          "command": "stm32-live-watch.stopServer",
          "when": "view == stm32-debug-variables-panel && stm32LiveWatch.serverRunning",
          "group": "navigation@1"
        },
        {
          "command": "stm32-live-watch.addVariable",
          "when": "view == stm32-debug-variables-panel",
          "group": "navigation@2"
        },
        {
          "command": "stm32-live-watch.prevWatchPage",
          "when": "view == stm32-debug-variables-panel",
          "group": "navigation@3"
        },
        {
          "command": "stm32-live-watch.watchPageIndicator",
          "when": "view == stm32-debug-variables-panel",
          "group": "navigation@4"
        },
        {
          "command": "stm32-live-watch.nextWatchPage",
          "when": "view == stm32-debug-variables-panel",
          "group": "navigation@5"
        },
        {
          "command": "stm32-live-watch.moreActions",
          "when": "view == stm32-debug-variables-panel",
          "group": "navigation@6"
        },
        {
          "command": "stm32-live-watch.addToChart",
          "when": "view == stm32-debug-chart-panel",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "stm32-live-watch.editVariable",
          "when": "view == stm32-debug-variables-panel && (viewItem == variable || viewItem == rootVariable)",
          "group": "inline"
        },
        {
          "command": "stm32-live-watch.renameVariable",
          "when": "view == stm32-debug-variables-panel && viewItem =~ /^rootVariable/",
          "group": "navigation"
        },
        {
          "command": "stm32-live-watch.deleteVariable",
          "when": "view == stm32-debug-variables-panel && viewItem =~ /^rootVariable/",
          "group": "navigation"
        },
        {
          "command": "stm32-live-watch.addToChart",
          "when": "view == stm32-debug-variables-panel && viewItem =~ /^rootVariable|^variable/",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "stm32-live-watch.addSelectedVariable",
          "when": "editorHasSelection && resourceLangId =~ /^(c|cpp|cuda-cpp)$/",
          "group": "navigation@50"
        }
      ]
    },
    "configuration": {
      "title": "STM32 Live Watch",
      "properties": {
        "stm32LiveWatch.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to Python interpreter"
        },
        "stm32LiveWatch.elfPath": {
          "type": "string",
          "default": "",
          "description": "Path to ELF file"
        },
        "stm32LiveWatch.fromelfPath": {
          "type": "string",
          "default": "",
          "description": "Path to Keil fromelf.exe used to convert EIDE AXF to ELF"
        },
        "stm32LiveWatch.openocdHost": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "OpenOCD TCL RPC host"
        },
        "stm32LiveWatch.openocdPort": {
          "type": "number",
          "default": 50001,
          "description": "OpenOCD TCL RPC port"
        },
        "stm32LiveWatch.refreshInterval": {
          "type": "number",
          "default": 250,
          "minimum": 100,
          "description": "Variable refresh interval in milliseconds (minimum 100ms)"
        },
        "stm32LiveWatch.chartRefreshInterval": {
          "type": "number",
          "default": 100,
          "minimum": 50,
          "description": "Chart data refresh interval in milliseconds (minimum 50ms)"
        },
        "stm32LiveWatch.chartTimeWindow": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "description": "Chart time window in seconds"
        },
        "stm32LiveWatch.autoWatchAxf": {
          "type": "boolean",
          "default": true,
          "description": "Automatically convert AXF to ELF when EIDE builds a new AXF file"
        },
        "stm32LiveWatch.reconnectInterval": {
          "type": "number",
          "default": 5000,
          "minimum": 1000,
          "description": "Auto-reconnect interval in milliseconds (minimum 1000ms)"
        }
      }
    },
    "colors": [
      {
        "id": "symbolIcon.structForeground",
        "description": "Struct symbol icon color",
        "defaults": { "dark": "#22D3EE", "light": "#0066CC", "highContrast": "#4FC1FF" }
      },
      {
        "id": "symbolIcon.classForeground",
        "description": "Class symbol icon color",
        "defaults": { "dark": "#FBBF24", "light": "#795E26", "highContrast": "#DCDCAA" }
      },
      {
        "id": "symbolIcon.arrayForeground",
        "description": "Array symbol icon color",
        "defaults": { "dark": "#A78BFA", "light": "#6F2F7B", "highContrast": "#C586C0" }
      },
      {
        "id": "symbolIcon.enumForeground",
        "description": "Enum/Union symbol icon color",
        "defaults": { "dark": "#F87171", "light": "#2E7D32", "highContrast": "#6A9955" }
      },
      {
        "id": "symbolIcon.stringForeground",
        "description": "String symbol icon color",
        "defaults": { "dark": "#FB923C", "light": "#A31515", "highContrast": "#CE9178" }
      },
      {
        "id": "symbolIcon.variableForeground",
        "description": "Variable symbol icon color",
        "defaults": { "dark": "#60A5FA", "light": "#001080", "highContrast": "#9CDCFE" }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && node copy-server.js",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "test:elf": "npm run compile && node out/elfResolver.test.js",
    "lint": "eslint src --ext ts",
    "package:server": "python3 build_server.py"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  }
}
