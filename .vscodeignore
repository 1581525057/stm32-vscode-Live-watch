# 发布包只需要运行产物、资源和必要说明，源码与测试不进入 VSIX。
src/**
tests/**
node_modules/**
.vscode-test/**
build/**
*.vsix
*.spec
**/__pycache__/**
**/*.pyc
**/*.tmp
out/*.test.js
out/*.test.js.map

# 这些文件只用于开发或打包流程，插件运行时不依赖。
tsconfig.json
build_server.py
copy-server.js
.superpowers/**
docs/**

# PyInstaller 构建产物（只需要 out/bin/ 下的 exe）
resources/build/**
resources/dist/**

# 源 exe 已复制到 out/bin/，bin/ 目录不需要进入 VSIX
bin/**

# Claude Code 配置（含敏感 token）
.claude/**
